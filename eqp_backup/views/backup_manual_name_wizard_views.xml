<odoo>
    <record id="view_backup_manual_name_wizard_form" model="ir.ui.view">
        <field name="name">backup.manual.name.wizard.form</field>
        <field name="model">backup.manual.name.wizard</field>
        <field name="arch" type="xml">
            <form string="Run Manual Backup">
                <group>
                    <field name="backup_id" invisible="1"/>
                    <field name="manual_name"
                           placeholder="Leave empty for default name"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            string="Run Backup"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
